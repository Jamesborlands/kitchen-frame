<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode/versionName are injected by build.sh from version.properties -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cottageview.kitchen">
  <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <application android:label="Kitchen" android:name=".app.KitchenApp"
      android:hardwareAccelerated="true" android:largeHeap="true"
      android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
    <activity android:name=".app.KitchenActivity" android:launchMode="singleTask"
        android:screenOrientation="landscape" android:stateNotNeeded="true"
        android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.HOME"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <receiver android:name=".app.BootReceiver">
      <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter>
    </receiver>
  </application>
</manifest>
